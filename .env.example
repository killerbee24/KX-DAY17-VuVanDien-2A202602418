# MWAPI exposes Gemini and Anthropic models through an OpenAI-compatible API.
# Copy this file to .env, add your key, and adjust model IDs to exactly match
# the names shown by your MWAPI account. Never commit the real .env file.

MWAPI_API_KEY=
MWAPI_BASE_URL=https://api.mwapi.dev/v1

# Main agent: Gemini through MWAPI.
LLM_PROVIDER=custom
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0

# Evaluation/judge model: Anthropic through the same MWAPI gateway.
JUDGE_PROVIDER=custom
JUDGE_MODEL=claude-sonnet-4-5
JUDGE_TEMPERATURE=0

COMPACT_THRESHOLD_TOKENS=1200
COMPACT_KEEP_MESSAGES=6
